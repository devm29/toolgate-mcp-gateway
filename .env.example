# Backend settings. `make` targets source this file from the repo root, and the API also reads
# backend/.env or ./.env on its own, so one copy here is enough:  cp .env.example .env
# The console has its own file: cp web/.env.example web/.env.local

TOOLGATE_ENV=dev
TOOLGATE_PUBLIC_URL=http://localhost:8101
TOOLGATE_DATABASE_URL=postgresql+asyncpg://toolgate@127.0.0.1:5501/toolgate
TOOLGATE_REDIS_URL=redis://127.0.0.1:6401/0

# Required to be unique, random and 32+ characters when TOOLGATE_ENV=prod (startup fails otherwise).
# The admin key is for scripts and CI; people use the console, which signs in with OAuth.
TOOLGATE_ADMIN_API_KEY=dev-admin-key
TOOLGATE_SESSION_SECRET=dev-session-secret-not-for-production-32

# The admin console's origin. Toolgate registers <origin>/api/auth/callback as its OAuth redirect URI.
TOOLGATE_CONSOLE_ORIGIN=http://localhost:3101

# Tool-poisoning classifier: offline (deterministic, no key) | anthropic | none
TOOLGATE_CLASSIFIER=offline
# TOOLGATE_ANTHROPIC_API_KEY=sk-ant-...
# TOOLGATE_ANTHROPIC_MODEL=claude-opus-5-5

# OpenTelemetry: none | console | otlp
TOOLGATE_OTEL_EXPORTER=none
# TOOLGATE_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# Seed bundled demo + red-team upstreams and serve the HTTP CRM fixture.
TOOLGATE_DEMO_FIXTURES=true

# Production hardening: run migrations as the schema owner and the API as this role,
# which then cannot update, delete or truncate the audit log (see migrations/0002).
# TOOLGATE_DB_APP_ROLE=toolgate_app

# Only read by docker compose, which passes it to the console container (local dev uses web/.env.local).
# TOOLGATE_CONSOLE_SESSION_SECRET=
