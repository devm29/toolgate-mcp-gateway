# Copy to web/.env.local. All values are read server-side by the console's route handlers only.

# Where the console's server reaches the Toolgate API (can be an internal address).
TOOLGATE_API_ORIGIN=http://127.0.0.1:8101
# The gateway's public URL (its OAuth issuer). Browsers are sent here to sign in.
TOOLGATE_PUBLIC_URL=http://localhost:8101
# The console's own public URL. Must match the backend's TOOLGATE_CONSOLE_ORIGIN, which registers
# <this URL>/api/auth/callback as the console's OAuth redirect URI.
TOOLGATE_CONSOLE_URL=http://localhost:3101
# Encrypts the session cookie that holds the signed-in admin's tokens. 32+ random characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"
TOOLGATE_CONSOLE_SESSION_SECRET=
